# Copy this file to `.env` (git-ignored) and fill in the values. They are read by `settings.py`.

# Discord bot token: Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional. healthchecks.io ping URL ("https://hc-ping.com/<uuid>"); only pinged when run as a systemd service
HEALTHCHECK_URL=

# Optional. healthchecks.io ping URL of the daily database backup (period 1 day); same rule as above
BACKUP_HEALTHCHECK_URL=
