; Checks the VPS's disk space, memory and pending updates, announces crashed services that are back up,
; and finally pings the healthcheck of this monitoring itself; started every 5 minutes by vps-resources.timer.
; A failed step skips the later ones, so a broken check also stops the pings.
; One-time setup: symlink both files into /etc/systemd/system/, so `git pull` updates them
; and LalaBot's deploy (`daemon-reload`) applies the changes:
; sudo systemctl link /home/ubuntu/LalaBot/vps-resources.service
; sudo systemctl enable --now /home/ubuntu/LalaBot/vps-resources.timer
;
; Other commands:
; systemctl list-timers vps-resources
; journalctl -u vps-resources -e

[Unit]
Description=Check the VPS's disk space, memory and updates, and announce crashed services that are back up

[Service]
Type=oneshot
User=ubuntu
ExecStart=/bin/sh /home/ubuntu/LalaBot/scripts/check_resources.sh
ExecStart=/bin/sh /home/ubuntu/LalaBot/scripts/check_recoveries.sh
ExecStart=/bin/sh /home/ubuntu/LalaBot/scripts/check_updates.sh
ExecStart=/bin/sh /home/ubuntu/LalaBot/scripts/ping_monitoring.sh
